# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./devcore.db

# ── Graph DB (Neo4j) ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── Cache / Queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Encryption (job hunter data at rest) ─────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_HUNTER_ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PLAYWRIGHT_MAX_CONCURRENCY=4
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── Vertex AI (server-side, not in Settings screen) ───────────────────────────
# https://cloud.google.com/vertex-ai
VERTEX_API_KEY=

# ── Google OAuth (server-side app credentials) ───────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (server-side app credentials) ────────────────────────────
# https://portal.azure.com/ → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers

# ── User API Keys (set in Settings → API Keys, NOT here) ─────────────────────
# These are stored encrypted in the database per user.
# Setting them here will have NO effect — configure them in the app settings screen.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPGRAM_API_KEY=
# HEYGEN_API_KEY=
# SIMLI_API_KEY=
# JUDGE0_API_KEY=
# SERP_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
# REED_API_KEY=
# SCRAPFLY_KEY=
