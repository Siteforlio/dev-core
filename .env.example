# =============================================================================
# Developer Core — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — The app will not start without these
# -----------------------------------------------------------------------------

# DeepSeek API key — used as the default LLM for all AI features
# Get one free at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Deepgram API key — used for real-time speech transcription during interviews
# Get one free at: https://console.deepgram.com (free tier: 200hrs/month)
DEEPGRAM_API_KEY=

# JWT secret — sign your own random string here (32+ chars)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-random-string-here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Encryption key for storing job hunter credentials (ATS logins)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_HUNTER_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# REQUIRED FOR JOB HUNTER — OAuth callbacks need a public URL
# ngrok is NOT part of Docker Compose — run it separately in a terminal:
#   ngrok http 8000
# Then paste your ngrok URL into NGROK_PUBLIC_URL below.
# IMPORTANT: Free ngrok assigns a random URL on every restart, breaking OAuth
# callbacks for LinkedIn and ATS portals. Options:
#   1. Paid ngrok static domain: https://dashboard.ngrok.com
#   2. Free alternative: Cloudflare Tunnel https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
# Get your authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
# -----------------------------------------------------------------------------

NGROK_AUTHTOKEN=
NGROK_PUBLIC_URL=
NGROK_STATIC_DOMAIN=

# -----------------------------------------------------------------------------
# DATABASE — Docker Compose manages these services automatically
# Change passwords before deploying to any non-local environment
# -----------------------------------------------------------------------------

POSTGRES_USER=devcore
POSTGRES_PASSWORD=devcore
POSTGRES_DB=devcore
DATABASE_URL=postgresql+asyncpg://devcore:devcore@localhost:5433/devcore

NEO4J_AUTH=neo4j/devcore123
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devcore123

REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# OPTIONAL — Enhanced features (app works without these)
# -----------------------------------------------------------------------------

# Anthropic Claude API — alternative LLM (app defaults to DeepSeek if blank)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini / Google Vertex AI — used by the Cluely overlay module for real-time suggestions
# Gemini key: https://aistudio.google.com/apikey
# Vertex: set up a Google Cloud project and service account
GEMINI_API_KEY=
VERTEX_API_KEY=

# Groq API key — used by Cluely overlay for fast inference
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=

# HeyGen API key — required for photorealistic avatar in Interview Prep
# Enterprise pricing: https://www.heygen.com/
HEYGEN_API_KEY=

# Simli API key — alternative avatar provider
SIMLI_API_KEY=

# OpenAI API key — used for Whisper transcription fallback
OPENAI_API_KEY=

# SerpAPI / Brave Search — used for web search in Cluely overlay
SERP_API_KEY=

# Judge0 API key — used for code execution sandbox in coding interview rounds
JUDGE0_API_KEY=

# -----------------------------------------------------------------------------
# SYSTEM
# -----------------------------------------------------------------------------

ENVIRONMENT=development
PLAYWRIGHT_MAX_CONCURRENCY=4
DEVCORE_FILE_INDEX_PATH=~/.devcore/file_index
